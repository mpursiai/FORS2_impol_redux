def find_master_bias(sci_dic, nights, out_dir, do_bias):

	string = "Creating the Master biases"
	print_title(string)

	for night in nights:
		for chip in chips:
			string = "Night: %10s; CHIP: %s" % (night, chip)
			print_title(string)
			# First check if master bias exists
			master_file = out_dir + "%s/" % night + "bias/" + "master_bias_%s.fits" % chip
			if os.path.isfile(master_file) and do_bias == False:
				print("Already reduced, if you want to re-do use --do_bias")
			else:
				bias_files = sci_dic[night][chip]["bias"]
				bias_data = np.asarray([fits.getdata(file) for file in bias_files])
				master_bias = np.median(bias_data, axis=0).astype("int16")
				fits.writeto(master_file, master_bias, header=fits.getheader(bias_files[0]), overwrite=True, output_verify="silentfix+ignore")
				print("File saved: %s" % master_file)
			# Add info to the dic
			sci_dic[night][chip]["master_bias"] = master_file
			print()

def subtract_bias(sci_dic, nights, out_dir, target_name, do_sci):
	#1) Subtract bias from the SCI files
	#2) Also remove cosmics at this step
	
	string = "Subtracting the Master bias from SCI files"
	print_title(string)

	print_title("Following Science file identified:")
	for night in nights:
		for chip in chips:
	
			filters = sci_dic[night][chip]["filters"]
			filters_unique = np.unique(filters)
			sci_files = sci_dic[night][chip]["sci"]
			master_bias = fits.getdata(sci_dic[night][chip]["master_bias"])

			for filt in filters_unique:
				string = "Night: %10s; Filter: %s; CHIP: %s" % (night, filt, chip)
				print_title(string)

				sci_files_filt = sci_files[filters == filt]
				print("%i files found for the setup" % len(sci_files_filt))

				# Check if the comb files are already created
				n_done = len(glob.glob(out_dir + "%s/" % night + "sci/*%s_*%s*" % (filt, "comb")))
				# If number of chip specific files == number of comb files no need to run again unless asked
				if n_done == len(sci_files_filt) and do_sci == False:
					print("Already reduced! If you want to re-do use --do_sci")

				else:
					#if not len(sci_files_filt) in np.arange(0,100,4):
					#	print("WARNING: NUMBER OF FILES NOT MULTIPLICATION OF FOUR")
					#	print("CHECK AND DELETE THE EXTRA ONES:")
					#	print()
					#	for file in sci_files_filt:
					#		sci_hdr = fits.getheader(file)
					#		print("%s, %6s, %8.1f" % (file, get_angle(sci_hdr), float(sci_hdr["EXPTIME"])))
					#	print()
					#	break
					cycle_counter = 1
					for file in sci_files_filt:
		
						sci_data = fits.getdata(file)
						sci_hdr = fits.getheader(file)
		
						# subtract bias
						sci_data = sci_data - master_bias
					
						# remove cosmics
						sci_data = remove_cosmics(sci_data, sci_hdr)
		
						#cycle
						cycle_temp = np.ceil(cycle_counter / 4)
						cycle_counter = cycle_counter + 1
		
						# save the data in a new folder
						sci_save_file = out_dir + "%s/" % night + "sci/" + "%s_%s_%.1f_%s_c%i.fits" % (target_name, filt, get_angle(sci_hdr), chip, cycle_temp)
				
						fits.writeto(sci_save_file, sci_data, header=sci_hdr, overwrite=True, output_verify="silentfix+ignore")
						print("Saved: %s" % sci_save_file)
				print()

def join_chips(nights, out_dir, do_sci):
	# Simple joining of the two chips
	# Right now literally just stacks them together
	
	print_title("Joining the chips and masking the beams")
	comb_dic = {}

	for night in nights:
		comb_dic[night] = {}

		# Find used filters
		# Note that this way relies on the name being in form "X_Y"

		all_files =  np.sort(glob.glob(out_dir + "%s/" % night + "sci/*"))
		filters = np.unique([file.split("_")[2] + "_" + file.split("_")[3] for file in all_files])
	
		for filt in filters:
			comb_dic[night][filt] = {}

			#Check if done already exists (num all_files == expected number of comb files angles*cycles)

			all_files  = np.sort(glob.glob(out_dir + "%s/" % night + "sci/*%s_*" % filt))

			# Find the number of cycles based on created files
			cycles = np.sort(np.unique([file.split("_")[-1].replace(".fits", "") for file in all_files]))

			print_title("Night: %10s; Filter: %s" % (night, filt))

			if len(all_files) == len(angles)*len(cycles) and do_sci == False:
				print("Already joined! If you want to redo use do_sci = True (Do only if raw files still exist!)")
				
				# Create the array for the masked files
				for cycle in cycles:
					comb_dic[night][filt][cycle] = {}
					for angle in angles:
						file =  glob.glob(out_dir + "%s/" % night + "sci/*%s_%.1f_comb_%s.fits" % (filt, angle, cycle))[0]
						comb_dic[night][filt][cycle][angle] = {"file":file}


			#Find the CHIP1 - CHIP2 pairs
			else:
				for cycle in cycles:
					comb_dic[night][filt][cycle] = {}
					for angle in angles:
						pair_str = out_dir + "%s/" % night + "sci/*%s_%.1f_CHIP*_%s.fits" % (filt, angle, cycle)
						pair_files = np.sort(glob.glob(pair_str))

						comb_file = pair_files[0].replace("CHIP1", "comb")
						
						data_chip1 = fits.getdata(pair_files[0])
						hdr_chip1  = fits.getheader(pair_files[0])
						
						data_chip2 = fits.getdata(pair_files[1])
						hdr_chip2  = fits.getheader(pair_files[1])
					
						##gain
						gain1 = hdr_chip1['HIERARCH ESO DET OUT1 GAIN']
						gain2 = hdr_chip2['HIERARCH ESO DET OUT1 GAIN']
						data_chip2 = data_chip2/gain2*gain1

						# Find gap width follwing eso_ipol    
						#xgap = header['HIERARCH ESO DET CHIP1 XGAP']# 30 microns
						ygap = hdr_chip1['HIERARCH ESO DET CHIP1 YGAP']# 480 microns (32pix)
						ypixbin = hdr_chip1['HIERARCH ESO DET WIN1 BINY'] #2
						ypixsize = hdr_chip1['HIERARCH ESO DET CHIP1 PSZY']*ypixbin #15 microns (w/o bin)
						naddy = int(ygap/ypixsize)
						y_size = len(data_chip1[0])

						gap_arr = np.zeros((naddy, y_size))
						
						# Create and empy array of shape y=naddy, x=x_width
						# Crudely stack the data together
						data_comb = np.concatenate((data_chip2, gap_arr, data_chip1), axis=0)

						# Crop all the extra out
						# But first find if taken with RED or BLUE CCD:
						ccd = hdr_chip1[ccd_key]
						crop_x_lims, crop_y_lims = find_crop_lims(ccd)
						data_comb = data_comb[crop_y_lims[0]:crop_y_lims[1], crop_x_lims[0]:crop_x_lims[1]]

						hdr_comb = hdr_chip2
						hdr_comb["NAXIS2"] = hdr_comb["NAXIS2"] * 2
						hdr_comb["EXTNAME"] = 'COMB'
		
						fits.writeto(comb_file, data_comb, header=hdr_comb, overwrite=True, output_verify="silentfix+ignore")
						print("Saved: %s" % comb_file)
						comb_dic[night][filt][cycle][angle] = {"file":comb_file}

						#Remove the chip files
						os.remove(pair_files[0])
						os.remove(pair_files[1])

			print()
	return comb_dic	

def mask_comb(data, ccd, beam):
	# Mask the comb array to have only e or o beam stripes

	e_lims, o_lims = find_strip_lims(ccd)

	if beam == "e":
		lims = e_lims
	elif beam == "o":
		lims = o_lims
	# find o and e beam y indexs to turn to 0
	rows = np.arange(0,np.size(data[:,0]),1)
	good_rows = np.r_[lims[0][0]:lims[0][1], lims[1][0]:lims[1][1], lims[2][0]:lims[2][1], lims[3][0]:lims[3][1], \
					  lims[4][0]:lims[4][1], lims[5][0]:lims[5][1], lims[6][0]:lims[6][1], lims[7][0]:lims[7][1]]
	bad_rows = np.asarray([ind for ind in rows if ind not in good_rows])

	data[bad_rows, :]=0
	return data

