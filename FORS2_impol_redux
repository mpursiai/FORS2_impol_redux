def FORS2_impol_redux(target_name, night="all", raw_dir="archive/", out_dir = "FORS2_impol/", do_sci=False, do_bias=False, do_phot=False, i_apers=np.arange(0.5,3.0,0.5), px_target_e=[], set_fwhm=None, bkg_type="2dmap", star_snr=200, star_fwhm_i=1.5, check_files="some"):

	#Print welcome
	string = "WELCOME TO FORS2 IMPOL REDUX! A Back-to-back reducer of FORS2 impol data"
	print_title(string, top=True)

	# FIRST HALF, GET THE SCIENCE FILES READY FOR ANALYSIS
	comb_dic = reduce_data(raw_dir, out_dir, target_name, do_sci, do_bias, do_phot, night, check_files)

	# SECOND HALF: THE ANALYSIS

	#1) Run Aperture photometry with photutils
	# Addition: night specific ccds are now carried through as they are needed for the instrumental correction in save_QUPX()

	cat_dic, ccds = run_photutils(comb_dic, out_dir, do_phot, i_apers, px_target_e, star_fwhm_i, set_fwhm=set_fwhm, bkg_type=bkg_type)

	# Find the needed flux ratios for everything
	Frs = create_fr_dic(cat_dic, out_dir, i_apers, star_snr, star_fwhm_i)

	#2) Find QUPX values
	save_QUPX(Frs, out_dir, i_apers, ccds)


def main(argv):
