							input_str = input_str.split()
							js_to_delete = np.asarray([int(ind) for ind in input_str]) - 1
							# Check if bad_inds make sense:
							xmatch = np.searchsorted(js, js_to_delete + 1)

							if len(xmatch) != len(js_to_delete):
								print()
								print("Not valid integers! Try again!")
