	parser.add_argument("-n",  "--night",      type=str, default="all", help='Specify wanted night (YYYY-MM-DD). Default "all".')
	parser.add_argument("-rd", "--raw_dir",    type=str, default="archive/",    help='The directory of the raw files (default archive/)')
