def QUPX_SNR(fr_dict, i_aper, target, star_num=0):
	# Solves the QUPX for set of cycles for night filt pair
	# First Q 0.0 an 45.0

	if target == "target":
		Q  = 0.5 * (fr_dict[angles[0]][target][i_aper]["fr"]     - fr_dict[angles[2]][target][i_aper]["fr"])
		Qe = 0.5 * (fr_dict[angles[0]][target][i_aper]["fre"]**2 + fr_dict[angles[2]][target][i_aper]["fre"]**2)**0.5
		U  = 0.5 * (fr_dict[angles[1]][target][i_aper]["fr"]     - fr_dict[angles[3]][target][i_aper]["fr"])
		Ue = 0.5 * (fr_dict[angles[1]][target][i_aper]["fre"]**2 + fr_dict[angles[3]][target][i_aper]["fre"]**2)**0.5
		SNR = np.nanmean([fr_dict[angles[j]][target][i_aper]["snr"] for j in [0,1,2,3]])

		#Addition: Find xo and yo for instrumental correction
		xo, yo = np.nanmean([fr_dict[angle][target][i_aper]["xo"] for angle in angles]), np.nanmean([fr_dict[angle][target][i_aper]["yo"] for angle in angles])
		xe, ye = np.nanmean([fr_dict[angle][target][i_aper]["xe"] for angle in angles]), np.nanmean([fr_dict[angle][target][i_aper]["ye"] for angle in angles])

	elif target == "stars":
		Q  = 0.5 * (fr_dict[angles[0]][target][i_aper][star_num]["fr"]     - fr_dict[angles[2]][target][i_aper][star_num]["fr"])
		Qe = 0.5 * (fr_dict[angles[0]][target][i_aper][star_num]["fre"]**2 + fr_dict[angles[2]][target][i_aper][star_num]["fre"]**2)**0.5
		U  = 0.5 * (fr_dict[angles[1]][target][i_aper][star_num]["fr"]     - fr_dict[angles[3]][target][i_aper][star_num]["fr"])
		Ue = 0.5 * (fr_dict[angles[1]][target][i_aper][star_num]["fre"]**2 + fr_dict[angles[3]][target][i_aper][star_num]["fre"]**2)**0.5
		SNR = np.nanmean([fr_dict[angles[j]][target][i_aper][star_num]["snr"] for j in [0,1,2,3]])
		
		#Addition: Find xo and yo for instrumental correction
		xo, yo = np.nanmean([fr_dict[angle][target][i_aper][star_num]["xo"] for angle in angles]), np.nanmean([fr_dict[angle][target][i_aper][star_num]["yo"] for angle in angles])
		xe, ye = np.nanmean([fr_dict[angle][target][i_aper][star_num]["xe"] for angle in angles]), np.nanmean([fr_dict[angle][target][i_aper][star_num]["ye"] for angle in angles])

	return Q, Qe, U, Ue, SNR, xo, yo, xe, ye


def chromatic_correction(filt, q, u):

	# adapted from eso_ipol.py by https://github.com/gongsale/FORS2-INSTPOL
	# Perorms rotation on q,u plane and returns the new q u values
	filters = np.array(['u_HIGH','b_HIGH','v_HIGH','R_SPECIAL','I_BESS'])
	#lams = np.array([361,440,557,655,768,656.3,381.4])#nm
	chrom = np.array([-2.07,1.54,1.80,-1.19,-2.89])/180.0*np.pi #In rad, from ESO manual
	
	# Estimated by myself
	#chrom = np.array([-1.86, 2.17, 1.74, -1.21, -2.86])/180.0*np.pi #deg to rad
	
	# this filt
	try:
		chcorr = chrom[np.asarray(filters == filt)][0]
	
		# equations (according to Cikota17):
		q_corr = q * np.cos(-2 * chcorr) - u * np.sin(-2 * chcorr)
		u_corr = q * np.sin(-2 * chcorr) + u * np.cos(-2 * chcorr)
		return q_corr, u_corr

	except IndexError:
		print_title("FILTER %s not known. Chromatic Correction is not performed" % filt)
	return q, u

def instrumental_correction(filt, x, y, q, u, ccd):
	# Corrects Q and U params for the instrumetnal correction following eq 12. in Gonzales-Gaitan et al. 2020

	# From http://dx.doi.org/10.1051/0004-6361/201936379
	# Note that Table 4. in the paper is wrong in many ways. Q should be U and vice versa and x should be y and vice versa
	# Based on testing against the inlap maps x0 and y0 values should be zero... 
	# The dictionary has now been formed to match the inlap maps
	if red_ccd_name in ccd:
		x_cen = 833.5
		y_cen = 872.0
	elif blue_ccd_name in ccd:
		x_cen = 835.0
		y_cen = 871.0
	
	try:
		def eq12(stokes, filt, x, y):
			eq_dict = {"Q":{'b_HIGH':    {"a":10.045*10**3,  "b":10.528*10**3,  "the":np.radians(-0.361),  "x0":x_cen, "y0":y_cen}  ,\
							'v_HIGH':    {"a":8.981 *10**3,  "b":9.574 *10**3,  "the":np.radians(-0.584),  "x0":x_cen, "y0":y_cen}  ,\
							'R_SPECIAL': {"a":8.781 *10**3,  "b":9.071 *10**3,  "the":np.radians(-2.644),  "x0":x_cen, "y0":y_cen}  ,\
							'I_BESS':    {"a":8.414 *10**3,  "b":8.443 *10**3,  "the":np.radians(-3.810),  "x0":x_cen, "y0":y_cen}} ,\
					   "U":{'b_HIGH':    {"a":10.995*10**3,  "b":10.673*10**3,  "the":np.radians(-43.172), "x0":x_cen, "y0":y_cen}  ,\
							'v_HIGH':    {"a":9.688 *10**3,  "b":10.129*10**3,  "the":np.radians(-43.894), "x0":x_cen, "y0":y_cen}  ,\
							'R_SPECIAL': {"a":9.208 *10**3,  "b":9.285 *10**3,  "the":np.radians(-48.478), "x0":x_cen, "y0":y_cen}  ,\
							'I_BESS':    {"a":8.556 *10**3,  "b":8.643 *10**3,  "the":np.radians(-49.274), "x0":x_cen, "y0":y_cen}} ,\
							}
	
			a   = eq_dict[stokes][filt]["a"]
			b   = eq_dict[stokes][filt]["b"]
			the = eq_dict[stokes][filt]["the"]
			x0  = eq_dict[stokes][filt]["x0"]
			y0  = eq_dict[stokes][filt]["y0"]
	
			inst_arr = ((x - x0)*np.sin(the) + (y - y0)*np.cos(the))**2.0 / b**2.0 \
		        	 - ((x - x0)*np.cos(the) - (y - y0)*np.sin(the))**2.0 / a**2.0
	
			return inst_arr
	
		q_inst = eq12("Q", filt, x, y)
		u_inst = eq12("U", filt, x, y)
	
		return q - q_inst, u - u_inst


	except KeyError:
		print("Filter %s not known! Instrumental Correction is not performed" % filt)

		return q, u

def P(Qs, Qes, Us, Ues):

	Ps = (Qs**2 + Us**2)**0.5
	Pes = (((Qs*Qes)**2 + (Us*Ues)**2))**0.5 / Ps
	#return np.around(Ps, decimals=3), np.around(Pes, decimals=3)
	return Ps, Pes

def X(Qs, Qes, Us, Ues):
	# polarization angle error in Patat paper

	Xs = 0.5 * np.arctan2(Us,Qs) * (180/np.pi)
	Ps, Pes = P(Qs, Qes, Us, Ues)
	Xes = Pes /2 / Ps  * (180/np.pi)
	return Xs, Xes


def P_bias_correction(qi, qe, ui, ue, rho=0, eq=37):
	# Polarisation bias correction ala:
	# Following https://academic.oup.com/mnras/article/439/4/4048/1175299 Eq. 37 or 20
	# Plaszczynski et al 2014
	if eq == 37:
		# Following eq 37
		pi, pe = P(qi, qe, ui, ue)
		b, ei = bi(qi, qe, ui, ue, rho=rho)
		pmas = pi - b**2 * ((1 - np.exp(-(pi)**2 / b**2)) / (2*pi))
		return pmas, ei
	elif eq == 20:
		pi, pe = P(qi, qe, ui, ue)
		#Eq 20. Used if qe == ue
		pmas = pi - pe**2 * ((1 - np.exp(-(pi)**2 / pe**2)) / (2*pi))
		return pmas, pe

def bi(qi, qe, ui, ue, rho=0):
	# Assuming that the errors are non-correlated (i.e. qe and ue are independent)
	# i.e. rho == 0
	# eqs. 30 and 31
	if rho == 0.:
		b_temp = ((qi**2 * ue**2 + ui**2 *qe**2) / (qi**2 + ui**2))**0.5
		e_temp = ((ui**2 * ue**2 + qi**2 *qe**2) / (qi**2 + ui**2))**0.5
		e_temp = (0.5*(qe**2 + ue**2))**0.5

	# Assuming that the errors are correlated (i.e. qe and ue are dependent)
	elif rho != 0.0:
		theta = 0.5 * np.arctan((2 * rho * qe * ue) / (qe**2 - ue**2)) 
		qe_pri = (eq**2 * np.cos(theta)**2 + ue**2 * np.sin(theta)**2 + rho * qe * ue * np.sin(2 * theta))**0.5
		ue_pri = (eq**2 * np.sin(theta)**2 + ue**2 * np.cos(theta)**2 - rho * qe * ue * np.sin(2 * theta))**0.5

		phi = np.arctan(ui/qi)

		b_temp = (ue_pri**2 * np.cos(phi - theta)**2 + qe_pri**2 * np.sin(phi - theta)  )**0.5
		e_temp = (qe_pri**2 * np.cos(phi - theta)**2 + ue_pri**2 * np.sin(phi - theta)  )**0.5

	return b_temp, e_temp



def save_QUPX(Frs, out_dir, i_apers, ccds):
	fmt = '{:3s} {:9s} {:9s} {:9s} {:9s} {:10s} {:10s} {:9s} {:9s} {:9s} {:9s} {:9s} {:9s} {:8s} {:9s} {:9s} {:9s} {:9s} {:9s}'.format

