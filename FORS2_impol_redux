def estimate_isp(q, qe, u, ue):
	q_isp  = np.nansum(q/qe**2,axis=0) / np.nansum(1/qe**2,axis=0)
	qe_isp = (1 / np.nansum(1/qe**2,axis=0))**0.5

	u_isp  = np.nansum(u/ue**2,axis=0) / np.nansum(1/ue**2,axis=0)
	ue_isp = (1 / np.nansum(1/ue**2,axis=0))**0.5

	return q_isp, qe_isp, u_isp, ue_isp



