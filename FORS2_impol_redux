def sort_raw_files(files, target_name):
	# Go through the files and return dictionary of SCI and BIAS files per night
	
	string = "Sorting the raw files in raw_dir"
	print_title(string)

	files_dic = {}
		
	for file in files:
		hdr = fits.getheader(file)
		mjd_temp     = hdr["MJD-OBS"] # mjd of start
		object_temp  = hdr["OBJECT"] # mjd of start
		chip_temp    = hdr["EXTNAME"] # The chip
		obs_cate     = hdr["HIERARCH ESO DPR CATG"] # the cateogry (e.g. science, acqusition)
		files_dic[file] = {"mjd":mjd_temp, "object":object_temp, "chip":chip_temp, "type":obs_cate}
	
	# First determine the observing nights in question
	mjds = np.asarray([files_dic[file]["mjd"] for file in files])
	
	mjds_for_nights = mjds - 0.5 # shift by 12h to make sure observations have the same date (i.e. the observing night)
	ts = Time(mjds_for_nights, format='mjd', scale='utc')
	nights = ts.to_value("iso", subfmt="date") # the observing nights
	nights_unique = np.unique(nights)
	
	# Add to the dic
	for i in range(len(files)):
		files_dic[files[i]]["night"] = nights[i]
	
	# restructure the dictionary to more useful form 
	objects = np.asarray([files_dic[file]["object"] for file in files])
	
	sci_dic = {}
	
	#Find all SCI and BIAS frames
	#############################
	
	# night, filter, angle, chip
	
	for night in nights_unique:
		sci_dic[night] = {}
		for chip in chips:
	
			sci_files =  np.asarray([file for file in files if files_dic[file]["object"] == target_name and files_dic[file]["night"] == night and files_dic[file]["chip"] == chip and files_dic[file]["type"] == "SCIENCE"])
			bias_files = np.asarray([file for file in files if files_dic[file]["object"] == "BIAS"      and files_dic[file]["night"] == night and files_dic[file]["chip"] == chip])
	
			sci_mjd  = np.nanmean([files_dic[file]["mjd"] for file in files if files_dic[file]["object"] == target_name and files_dic[file]["night"] == night and files_dic[file]["chip"] == chip])
			bias_mjd = np.nanmean([files_dic[file]["mjd"] for file in files if files_dic[file]["object"] == "BIAS"      and files_dic[file]["night"] == night and files_dic[file]["chip"] == chip])
			
			sci_dic[night][chip] = {"sci":sci_files, "bias":bias_files, "sci_mjd":sci_mjd, "bias_mjd":bias_mjd}
	
			if len(sci_files) > 0:
				# find used filters and angles and add them in to sci_dic
				filters = [get_filter(fits.getheader(file)) for file in sci_files]
				angles = [get_angle(fits.getheader(file)) for file in sci_files]
				sci_dic[night][chip]["filters"] = np.asarray(filters) 
				sci_dic[night][chip]["angles"]  = np.asarray(angles)
				
	# Go throught the science frames
	sci_nights  = np.asarray([night for night in list(sci_dic.keys()) if len(sci_dic[night]["CHIP1"]["sci"])  != 0])
	bias_nights = np.asarray([night for night in list(sci_dic.keys()) if len(sci_dic[night]["CHIP1"]["bias"]) != 0])
	bias_mjds   = np.asarray([sci_dic[night]["CHIP1"]["bias_mjd"] for night in list(sci_dic.keys()) if len(sci_dic[night]["CHIP1"]["bias"]) != 0])
	
	for night in sci_nights:
		if night not in bias_nights:
			# Find the closest biases
			sci_mjd = sci_dic[night]["CHIP1"]["sci_mjd"]
			bias_night = bias_nights[np.argmin(np.abs(sci_mjd - bias_mjds))]
		else: 
			bias_night = night
		
		# Add correct bias files in in the dictionary
		for chip in chips:
			sci_dic[night][chip]["bias"] = sci_dic[bias_night][chip]["bias"]
	
	#Remove extra nights
	for night in nights_unique:
		if night not in sci_nights:
			sci_dic.pop(night, None)	
	
	return sci_dic

