def find_fr(xos, yos, fwhmos, snros, fos, feos, pixo, xes, yes, fwhmes, snres, fes, fees, pixe):
	# Find the Fr flux ratios

	# First ordinary
	dist_o = ((xos - pixo[0])**2+ (yos - pixo[1])**2)**0.5
	o_ind = np.argmin(np.abs(dist_o))
	
	# Then extraordinary
	dist_e = ((xes - pixe[0])**2+ (yes - pixe[1])**2)**0.5
	e_ind = np.argmin(np.abs(dist_e))

	xo, yo, fwhmo = xos[o_ind], yos[o_ind], fwhmos[o_ind]
	xe, ye, fwhme = xes[e_ind], yes[e_ind], fwhmes[e_ind]
	fo, foe, fe, fee = fos[o_ind], feos[o_ind], fes[e_ind], fees[e_ind]

	fr_temp = (fo - fe) / (fo + fe)
	fre_temp = (((2*fe*foe)**2 + (2*fo*fee)**2) / (fo + fe)**4)**0.5
	snr = (fo + fe) / (foe**2 + fee**2)**0.5

	return xo, yo, fwhmo, xe, ye, fwhme, fr_temp, fre_temp, fo, foe, fe, fee, snr

def combine_cycles(Frs, night, filt, cycles, target, i_apers, star_nums=0):
	# Combine the Frs of cycles together

	# First check if key Frs_dic["comb"] exists
	if "comb" not in list(Frs[night][filt].keys()):
		Frs[night][filt]["comb"] = {}
		for angle in angles:
			Frs[night][filt]["comb"][angle] = {}	

	for angle in angles:
		for i in i_apers:

			xos = []
			yos = []
			xes = []
			yes = []
			fwhms = []
			fwhmes = []
			fwhmos = []

			frs  = []
			fres = []
			fos  = []
			foes = []
			fes  = []
			fees = []
			snrs = []
			
			for j in range(len(cycles)):
				cycle = cycles[j]
				if target == "target" :
					temp_dic = Frs[night][filt][cycle][angle][target][i]
				else:
					#With cycle specific star id star_nums[j]
					temp_dic = Frs[night][filt][cycle][angle][target][i][star_nums[j]]

				xos.append(   temp_dic["xo"])
				yos.append(   temp_dic["yo"])
				xes.append(   temp_dic["xe"])
				yes.append(   temp_dic["ye"])
				fwhms.append(temp_dic["fwhm"])
				fwhmos.append(temp_dic["fwhmo"])
				fwhmes.append(temp_dic["fwhme"])
				frs.append(   temp_dic["fr"])
				fres.append(  temp_dic["fre"])
				fos.append(   temp_dic["fo"])
				foes.append(  temp_dic["foe"])
				fes.append(   temp_dic["fe"])
				fees.append(  temp_dic["fee"])
				snrs.append(  temp_dic["snr"])
	
			# Weighted mean of fr (plus the error) over cycles
			# Ratios
			frs = np.asarray(frs)
			fres = np.asarray(fres)
			fr = np.nansum(frs/fres**2) / np.nansum(1/fres**2)
			fr_err = (1 / np.nansum(1/fres**2))**0.5
			# o-beam
			fos = np.asarray(fos)
			foes = np.asarray(foes)
			fo = np.nansum(fos/foes**2) / np.nansum(1/foes**2)
			fo_err = (1 / np.nansum(1/foes**2))**0.5				
			# e-beam
			fes = np.asarray(fes)
			fees = np.asarray(fees)
			fe = np.nansum(fes/fees**2) / np.nansum(1/fees**2)
			fe_err = (1 / np.nansum(1/fees**2))**0.5	

			# mean snr over cycler
			snr = np.nanmean(snrs)*np.sqrt(len(snrs))

			# mean for location and fwhm
			xo = np.nanmean(xos)
			yo = np.nanmean(yos)
			xe = np.nanmean(xes)
			ye = np.nanmean(yes)
			fwhm = np.nanmean(fwhms)
			fwhmo = np.nanmean(fwhmos)
			fwhme = np.nanmean(fwhmes)

			dict_to_add = {"xo":xo, "yo":yo, "xe":xe, "ye":ye, "fwhm":fwhm, "fwhmo":fwhmo, "fwhme":fwhme, \
			               "fr":fr, "fre":fr_err, "fo":fo, "foe":fo_err, "fe":fe, "fee":fe_err, "snr":snr}

			# Check if the angle -- target dict exists
			if target not in Frs[night][filt]["comb"][angle]:
				Frs[night][filt]["comb"][angle][target] = {}


			if target == "target" :
				Frs[night][filt]["comb"][angle][target][i] = dict_to_add
			else:
				# check if dict exists
				#print(list(Frs[night][filt]["comb"][angle][target].keys()))
				#if len(list(Frs[night][filt]["comb"][angle][target].keys())) == 0:
				if i not in Frs[night][filt]["comb"][angle][target]:
					Frs[night][filt]["comb"][angle][target][i] = {}
					star_ind = 1
				else:
					star_ind = np.amax(list(Frs[night][filt]["comb"][angle][target][i].keys())) + 1
				
				Frs[night][filt]["comb"][angle][target][i][star_ind] = dict_to_add

	return Frs

